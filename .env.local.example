# Recommended: Add your Groq API key (ultra-fast free tier: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional Fallback: Google Gemini API key (https://aistudio.google.com/apikey)
# Without either key, the app automatically uses its built-in Tinglish comedy simulator!
GEMINI_API_KEY=your_gemini_api_key_here
